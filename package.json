{
  "name": "civora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:pwa": "npm run schemas:check && npm run build && node scripts/build-pwa.mjs",
    "dev": "npm run build:pwa && node scripts/serve-pwa.mjs",
    "dev:lan": "node scripts/serve-pwa-lan.mjs",
    "dev:attach": "npm run build:pwa && node scripts/attach-pwa.mjs",
    "pwa:host": "npm run build:pwa && node scripts/host-pwa.mjs",
    "test:pwa": "npm run build:pwa && node scripts/test-pwa.mjs",
    "test:pwa:lan": "npm run build:pwa && node scripts/test-pwa-lan.mjs",
    "notifications": "npm run build && node dist/services/notifications/cli.js",
    "test:notifications": "npm run build:pwa && node --test dist/web/test/notifications.test.js && node scripts/test-notifications-browser.mjs",
    "test": "npm run build && node --test dist/web/test/*.test.js",
    "fixtures": "npm run build && node dist/scripts/generate-fixtures.js",
    "schemas": "node scripts/generate-schemas.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check",
    "format:check": "prettier --check \"web/**/*.ts\" \"scripts/**/*.ts\" \"services/**/*.ts\" \"scripts/*.mjs\" package.json tsconfig.json",
    "crypto:check": "npm run build && node scripts/check-semaphore.mjs",
    "artifacts:fetch": "node scripts/fetch-semaphore.mjs",
    "browsers:install": "node scripts/install-eligibility-browsers.mjs",
    "fixtures:eligibility": "npm run build && node scripts/generate-eligibility-fixtures.mjs",
    "fixtures:eligibility:check": "npm run build && node scripts/generate-eligibility-fixtures.mjs --check",
    "test:browser": "npm run build && node scripts/test-eligibility-browsers.mjs",
    "test:scale": "npm run build && node scripts/check-eligibility-scale.mjs",
    "test:consensus": "npm run build && node scripts/test-consensus.mjs",
    "test:citizen:native": "npm run build && node scripts/test-citizen-native.mjs",
    "fixtures:citizen:check": "go run -buildvcs=false ./cmd/civnode fixtures -check -certified",
    "audit:citizen": "npm run build && node scripts/audit-citizen.mjs",
    "fixtures:partitions": "npm run build && node scripts/generate-partition-ballots.mjs",
    "fixtures:partitions:check": "npm run build && node scripts/generate-partition-ballots.mjs --check",
    "fixtures:electionguard": "npm run build && node scripts/prepare-electionguard-oracle.mjs && node scripts/materialize-electionguard.mjs && node scripts/generate-electionguard-fixtures.mjs && node scripts/generate-electionguard-negatives.mjs && node scripts/generate-scale-fixtures.mjs && node scripts/generate-encrypted-fixtures.mjs",
    "fixtures:electionguard:check": "npm run build && node scripts/prepare-electionguard-oracle.mjs --check && node scripts/materialize-electionguard.mjs --check && node scripts/generate-electionguard-fixtures.mjs --check && node scripts/generate-electionguard-negatives.mjs --check && node scripts/generate-scale-fixtures.mjs --check && node scripts/generate-encrypted-fixtures.mjs --check",
    "crypto:electionguard:review": "npm run build && node scripts/review-electionguard.mjs",
    "crypto:electionguard:gate": "npm run build && node scripts/review-electionguard.mjs --require-qualified",
    "crypto:electionguard:audit": "npm run build && node scripts/audit-electionguard.mjs",
    "artifacts:electionguard:fetch": "node scripts/review-electionguard.mjs --fetch --check-local",
    "qualify": "npm run build && node dist/services/qualification/cli.js",
    "test:qualification": "npm run build && node scripts/test-qualification.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:compare": "node scripts/compare-release.mjs",
    "test:distribution": "npm run build && node scripts/test-distribution.mjs",
    "release:finalize": "node scripts/finalize-release.mjs",
    "test:release": "node --test scripts/distribution.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "ajv": "8.17.1",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@noble/hashes": "1.3.2",
    "buffer": "6.0.3",
    "@noble/curves-comet": "npm:@noble/curves@2.4.0",
    "@semaphore-protocol/group": "4.14.5",
    "@semaphore-protocol/identity": "4.14.5",
    "@semaphore-protocol/proof": "4.14.5",
    "poseidon-lite": "0.3.0"
  }
}
