{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civora.invalid/distribution/v1/release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_version", "channel", "public_qualified", "verified_capacity_ballots", "created", "targets", "files", "protocol_activation"],
  "properties": {
    "schema_version": {"const": "1"},
    "release_version": {"const": "1.0.0"},
    "channel": {"const": "experimental"},
    "public_qualified": {"const": false},
    "verified_capacity_ballots": {"type": "null"},
    "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "targets": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["windows-amd64", "linux-amd64", "linux-arm64"]}},
    "files": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/file"}},
    "protocol_activation": {"const": false}
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,15})$"}
      }
    }
  }
}
