{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civora.invalid/distribution/v1/source",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "files"],
  "properties": {
    "format": {"const": "civora-source-1"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "maxLength": 240, "pattern": "^[A-Za-z0-9._/-]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,7})$"}
        }
      }
    }
  }
}
