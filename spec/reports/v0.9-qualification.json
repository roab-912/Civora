  "implemented": {
    "receipt_collector": {
      "command": "cmd/civqual",
      "scope": "Authenticated native deposit receipts, not complete ballot validity or tally certification",
      "independently_pinned_frozen_context": true,
      "individual_receipt_proofs": true,
      "duplicates_excluded_from_throughput": true,
      "empty_seconds_included": true,
      "failures_published_separately": true,
      "canonical_jsonl": true,
      "canonical_immutable_utf8_output": true,
      "memory": "Deduplication set grows linearly with unique envelope digests; at most 20 million samples per input"
    },
    "off_chain_recovery": {
      "command": "cmd/civrecovery",
      "signature": "Pure ML-DSA-65, empty context, on the prescribed 48-byte SHA3-384 digest",
      "implementations": [
        "Go/CIRCL 1.6.3",
        "Node 24.12.0 / OpenSSL 3.5.4 independent verification"
      ],
      "quorums": "5/7 technical AND 5/7 civic; all identities and keys distinct",
      "freshness": "3/5 separate mirror signatures, at most 10 minutes",
      "persistent_state": "bbolt transaction, pinned root, monotone counters per recovery epoch and nondecreasing observed clock",
      "rotation": "Both old and new college quorums plus a mandatory constitutional approval verifier; TEST_ONLY adapter in exercises",
      "authority": "Off-chain read-only state and signed references only. No block, result, import or reserve activation is authorized by this tool.",
      "existing_genesis_modified": false
    },
    "qualification_gate": {
      "command": "npm run qualify",
      "strict_schemas": true,
      "canonical_campaign_policy_and_receipt_reports": true,
      "artifact_hashes_sizes_and_directory_confinement": true,
      "streamed_large_artifact_hashing": true,
      "thresholds": "10M unique receipts, 32 partitions, 5000/s for 900s, p95 <=10s/p99 <=30s, one hot partition 320/s for >=60s, 20M full checks at >=500/s, backlog and certification <=24h, physical mobile generation p95 <=8s",
      "external_crypto_and_application_audits_required": true,
      "critical_and_high_findings_must_be_fixed": true,
      "independently_pinned_reviewer_policy": "3/5 organizations sign the canonical campaign and artifact references",
      "current_default_exit_code": 2,
      "scope": "Authenticates evidence and reviewer declarations and applies thresholds; independent auditors must validate measurement truth and operator independence"
    },
    "onchain_safety": {
      "scope": "Explicit opt-in development_TEST_ONLY genesis/configuration; no existing session is assigned a recovery root",
      "authority": "security.hold only; no reserve activation, vote, effect, state import or restoration of revoked modules",
      "ordering": "At most four authenticated holds, before affected deadline transitions, admission and effects; proposal selection prioritizes holds",
      "clock": "Authenticated block time; mirror observations are required only off chain",
      "persistent_state": "Counter metadata plus individual signed order entries; deterministic journal replay",
      "polls": "Interrupted decisions retain results, planned dates, ciphertexts, deposits and receipts; elapsed time never resumes them",
      "partitions": "Interrupted checkpoint cannot certify; processing stops while exact historical deposit retry and receipt verification remain available",
      "clients": "Current PWA refuses writes under a recovery configuration it cannot independently operate",
      "root_and_module_policy": "Test root is genesis-bound; held modules remain under safety review for new operations until safe authorization of approved replacements"
    }
  },
